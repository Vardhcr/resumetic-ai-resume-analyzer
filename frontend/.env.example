# Resumetic Frontend Environment Variables
# Copy this file to `.env` and adjust values as needed.

# Backend API base URL.
# Leave empty to use automatic detection:
#   - localhost / LAN IP  ->  http://<hostname>:8000
#   - otherwise           ->  production Railway URL
#
# For mobile / LAN testing, set this to your computer's IP:
# VITE_API_BASE_URL=http://192.168.1.5:8000
VITE_API_BASE_URL=

